<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    tools:context=".app.MainActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@mipmap/cookie_run_bg_1"
        />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:gravity="center"
        android:background="#8fff"
        android:padding="40dp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/cookie_run_title"
            />
        <Space
            android:layout_width="wrap_content"
            android:layout_height="40dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/prevStageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="onBtnPreviousStage"
                android:minWidth="30dp"
                android:text="&lt;" />

            <TextView
                android:id="@+id/stageTextView"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/title_stage_fmt"
                android:textSize="24sp" />

            <Button
                android:id="@+id/nextStageButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="onBtnNextStage"
                android:minWidth="30dp"
                android:text="&gt;" />
        </LinearLayout>

        <Space
            android:layout_width="wrap_content"
            android:layout_height="24dp" />

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Game"
            android:onClick="onBtnStartGame"
            />

    </LinearLayout>
</FrameLayout>
